{
    // ── Editor ──────────────────────────────────────────────────────
    "editor.cursorSurroundingLines": 100,
    "editor.fontFamily": "xUbuntuMono Nerd Font Mono, Monaco, 'Courier New', monospace",
    "editor.fontSize": 13,
    "editor.formatOnSaveMode": "modifications",
    "editor.inlineSuggest.enabled": true,
    "editor.largeFileOptimizations": false,
    "editor.lineNumbers": "relative",
    "editor.minimap.enabled": false,
    "editor.renderControlCharacters": true,
    "editor.rulers": [120],
    "editor.stickyScroll.enabled": false,
    "editor.tabSize": 4,
    "editor.unicodeHighlight.allowedCharacters": { "️": true },
    "breadcrumbs.enabled": true,
    "diffEditor.ignoreTrimWhitespace": false,

    // ── Files and explorer ──────────────────────────────────────────
    "files.autoSave": "onFocusChange",
    "files.exclude": {
        "**.meta": true,
        "**/.git": true,
        "**/__pycache__": true,
        "**/Library": true
    },
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,

    // ── Workbench and window ────────────────────────────────────────
    "window.commandCenter": false,
    "window.density.layout": "compact",
    "window.titleBarStyle": "custom",
    "workbench.activityBar.compact": true,
    "workbench.activityBar.location": "top",
    "workbench.editor.empty.hint": "hidden",
    "workbench.editor.enablePreviewFromCodeNavigation": true,
    "workbench.editor.enablePreviewFromQuickOpen": true,
    "workbench.editor.tabSizing": "shrink",
    "workbench.enableExperiments": false,
    "workbench.layoutControl.enabled": false,
    "workbench.sideBar.location": "right",
    "workbench.startupEditor": "none",
    "workbench.statusBar.visible": true,
    "workbench.tree.enableStickyScroll": true,
    "workbench.tree.stickyScrollMaxItemCount": 20,
    "zenMode.centerLayout": false,
    "zenMode.hideStatusBar": false,

    // ── Theme and colors ────────────────────────────────────────────
    "workbench.colorTheme": "GitHub Dark Default",
    "workbench.colorCustomizations": {
        "editorRuler.foreground": "#3a3a3a",
        "[Default Dark+]": {
            "activityBar.background": "#111111",
            "activityBar.border": "#242424",
            "dropdown.background": "#242424",
            "editor.background": "#161616",
            "editor.selectionBackground": "#242424",
            "editorCursor.foreground": "#5e5e5e",
            "editorGroupHeader.tabsBackground": "#1b1b1b",
            "focusBorder": "#3a3a3a",
            "input.background": "#242424",
            "scrollbar.shadow": "#ff161616",
            "sideBar.background": "#111111",
            "sideBar.border": "#242424",
            "statusBar.background": "#111111",
            "statusBar.border": "#242424",
            "statusBar.debuggingBackground": "#00344e",
            "statusBar.noFolderBackground": "#242424",
            "tab.activeBackground": "#161616",
            "tab.inactiveBackground": "#1d1d1d",
            "terminalCursor.foreground": "#5e5e5e",
            "titleBar.activeBackground": "#000000",
            "titleBar.border": "#242424",
            "widget.shadow": "#ff161616"
        }
    },
    "editor.semanticTokenColorCustomizations": { "enabled": true },
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": [
                    "entity.other.attribute-name",
                    "meta",
                    "storage.modifier",
                    "storage.type",
                    "storage.type.modifier",
                    "variable.parameter"
                ],
                "settings": { "fontStyle": "" }
            }
        ]
    },

    // ── Terminal and shell ──────────────────────────────────────────
    "application.shellEnvironmentResolutionTimeout": 10,
    "terminal.external.osxExec": "Alacritty.app",
    "terminal.integrated.fontFamily": "'UbuntuMono Nerd Font'",
    "terminal.integrated.fontSize": 15,
    "terminal.integrated.scrollback": 5000,

    // ── Git ─────────────────────────────────────────────────────────
    "git.autofetch": true,
    "git.closeDiffOnOperation": true,
    "git.openRepositoryInParentFolders": "never",
    "gitlens.home.preview.enabled": false,
    "gitlens.integrations.enabled": true,
    "gitlens.remotes": [
        { "domain": "github.cds.internal.unity3d.com", "type": "GitHub" }
    ],

    // ── Vim ─────────────────────────────────────────────────────────
    "vim.foldfix": true,
    "vim.leader": " ",
    "vim.overrideCopy": false,
    "vim.useSystemClipboard": true,
    "vim.insertModeKeyBindings": [
        { "before": ["j", "j"], "after": ["<ESC>", "l"] }
    ],
    "vim.normalModeKeyBindings": [
        { "before": ["E"], "after": ["$"] },
        { "before": ["B"], "after": ["0"] },
        { "before": [":", "W"], "after": [":", "w"] },
        { "key": ["<C-o>"], "commands": "workbench.action.navigateBack", "when": "canNavigateBack" },
        { "key": ["<C-i>"], "commands": "workbench.action.navigateForward", "when": "canNavigateForward" }
    ],
    "vim.visualModeKeyBindings": [
        { "before": ["E"], "after": ["$"] },
        { "before": ["B"], "after": ["0"] }
    ],

    // ── AI assistants ───────────────────────────────────────────────
    "chat.viewSessions.orientation": "stacked",
    "claudeCode.hideOnboarding": true,
    "claudeCode.preferredLocation": "sidebar",
    "github.copilot.advanced": {},
    "github.copilot.enable": {
        "*": true,
        "markdown": true,
        "plaintext": true,
        "scminput": false
    },
    "github.copilot.nextEditSuggestions.enabled": true,

    // ── Extensions ──────────────────────────────────────────────────
    "extensions.ignoreRecommendations": true,
    "errorLens.enabledDiagnosticLevels": ["warning", "info"],
    "errorLens.excludeBySource": ["C/C++(1696)", "Java(268435846)"],
    "apklab.apkSignerPath": "/Users/manuel.gil/.apklab/uber-apk-signer-1.3.0.jar",
    "apklab.apktoolPath": "/Users/manuel.gil/.apklab/apktool_3.0.2.jar",
    "apklab.jadxDirPath": "/Users/manuel.gil/.apklab/jadx-1.5.6",
    "apklab.smaliLspPath": "/Users/manuel.gil/.apklab/smali-lsp-1.5.0.jar",
    "cmake.configureOnOpen": true,
    "csv.enabled": false,
    "sqlite3-editor.ui.minimizePanel": true,
    "sqlite3-editor.ui.tableSelector.displayColumns": true,

    // ── Debug and security ──────────────────────────────────────────
    "debug.onTaskErrors": "showErrors",
    "security.workspace.trust.untrustedFiles": "open"
}
